{
  "name": "rh-dashboard-react",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test src/lib/*.test.js",
    "test:ui": "playwright test",
    "test:sql": "node --test tests/sql/*.test.js",
    "pointeuses:diagnostic": "node scripts/check-pointeuses.mjs",
    "pointeuses:setup": "python -m pip install --target .pointage-tools/python -r config/pointeuses-requirements.txt --disable-pip-version-check",
    "pointeuses:bridge": "node scripts/pointeuses-bridge.mjs",
    "pointeuses:start": "powershell -NoProfile -File scripts/start-pointeuses.ps1",
    "test:pointeuses": "node --test tests/pointeuses/*.test.mjs",
    "test:pointeuses:reader": "python -m unittest discover -s tests/pointeuses -p *_test.py",
    "pointage:generate": "powershell -ExecutionPolicy Bypass -File scripts/generate-classeur1-pointage.ps1"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@supabase/supabase-js": "^2.56.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^4.3.2",
    "tailwindcss": "^4.3.3",
    "vite": "^5.4.10"
  }
}
